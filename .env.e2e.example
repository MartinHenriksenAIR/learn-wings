# Copy to .env.e2e (gitignored) and fill in. Never commit the real file.
#
# No credentials belong here. Authenticated specs replay a session a human
# captured by hand, once, and re-capture when it expires:
#   npm run e2e:capture
# (that script sources this file; the bare `playwright open` command does not
# work, because nothing exports E2E_BASE_URL to a shell)
E2E_BASE_URL=https://black-forest-0d7f96c03.7.azurestaticapps.net
E2E_INVITE_TO=platform-admin@example.com
