# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment variables — never commit secrets
.env
.env.*
!.env.example
# The Playwright suite's credentials live in .env.e2e; only the value-free
# template is tracked, and the .env.* glob above would otherwise hide it.
.env.e2e
!.env.e2e.example
local.settings.json

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Playwright MCP session artifacts
.playwright-mcp/
.claude/worktrees/

# Playwright e2e suite artifacts (on-demand runs, never CI)
playwright-report/
test-results/
e2e/.auth/

# Claude Code local state (per-machine, never committed)
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Helm (autonomous task runner) — only the committed context manifest is tracked
.helm/*
!.helm/context.md
