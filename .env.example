VITE_ENTRA_CLIENT_ID=
VITE_API_BASE_URL=
# Entra redirect URI. Optional; defaults to the app's own origin
# (window.location.origin — http://localhost:8080 on the Vite dev server).
VITE_REDIRECT_URI=
# Public base URL used when minting invite links (e.g. https://ai-uddannelse.dk).
# Prod pins this at the domain cutover; previews/local leave it unset and fall
# back to the app's own origin (window.location.origin).
VITE_PLATFORM_BASE_URL=
